FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# App Identity
APP_NAME=Cinepass
APP_URL=https://cinepass-1.onrender.com

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=cinepass_db
ALLOW_FALLBACK_DB=true

# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_cinepass2026key
RAZORPAY_KEY_SECRET=cinepass_test_secret_99887766
CONVENIENCE_FEE_PER_TICKET=30.0
GST_PERCENTAGE=18.0

# Seat Lock Settings
SEAT_LOCK_TIMEOUT_SECONDS=480

# Administrator Credentials
ADMIN_EMAIL=admin@cinepass.com
ADMIN_PASSWORD=CinePass@Admin2026

# AI Movie Concierge & Summary Configuration (Optional)
# Supported SUMMARY_PROVIDER: gemini, openai, openrouter
SUMMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
SUMMARY_OPENROUTER_MODEL=google/gemini-2.5-flash-lite
